# SentinelAI — Streamlit Cloud secrets template.
#
# Usage:
#   * Streamlit Cloud: paste the keys below into the app's "Secrets"
#     panel (App settings -> Secrets).
#   * Local development: copy this file to .streamlit/secrets.toml.
#
# Every key defined here is also exposed to the app as an environment
# variable, so the dashboard can read it with os.getenv(...).

# Base URL of the deployed SentinelAI API (e.g. the Railway service).
# No trailing slash. If unset, the dashboard falls back to
# http://localhost:8000.
API_URL = "https://your-sentinelai-api.up.railway.app"
